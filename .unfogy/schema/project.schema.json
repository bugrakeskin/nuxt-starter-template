{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unfogy.com/schemas/customer-mwo-project/v1",
  "title": "Unfogy Customer MWO Application Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "project"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "CustomerMWOApplication"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["customer_ref", "mwo_ref", "title", "summary"],
      "properties": {
        "customer_ref": {
          "type": "string",
          "description": "Existing user-facing Customer reference.",
          "pattern": "^CST[0-9]+$"
        },
        "mwo_ref": {
          "type": "string",
          "description": "Canonical MWO identity allocated by the Control Plane.",
          "pattern": "^MWO[0-9]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "folders": {
          "type": "object",
          "description": "Optional purposes for top-level project folders.",
          "propertyNames": {
            "pattern": "^(?:\\.[a-z][a-z0-9-]*|[a-z][a-z0-9-]*)$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "shortname": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "maxLength": 40
        }
      }
    }
  }
}
