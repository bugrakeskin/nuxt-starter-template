{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unfogy.com/schemas/customer-project-environment/v1",
  "title": "Unfogy Customer Project Environment Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "project_id", "environment", "recipe", "domains", "required_environment_keys"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "CustomerProjectEnvironment"
    },
    "project_id": {
      "type": "string",
      "description": "The permanent project ID owning this environment.",
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "environment": {
      "enum": ["staging", "production"]
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^v[0-9]+$"
        }
      }
    },
    "domains": {
      "type": "object",
      "additionalProperties": false,
      "required": ["web", "api"],
      "properties": {
        "web": {
          "type": "string",
          "format": "uri"
        },
        "api": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "required_environment_keys": {
      "type": "array",
      "description": "Names only; values are supplied by the approved environment secret/configuration store.",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "uniqueItems": true
    },
    "provider_refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coolify_project_uuid": {
          "type": "string",
          "minLength": 1
        },
        "coolify_environment_uuid": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
