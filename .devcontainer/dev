#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ACTION=${1:-}

serve() {
  chown -R node:node /pnpm/store /workspace/node_modules /workspace/.nuxt
  dependency_hash=$(
    sha256sum /workspace/package.json /workspace/pnpm-lock.yaml | sha256sum | cut -d' ' -f1
  )
  marker=/pnpm/store/.unfogy-dependency-hash
  installed_hash=$(cat "$marker" 2>/dev/null || true)
  if [ "$installed_hash" != "$dependency_hash" ] || [ ! -f /workspace/node_modules/.modules.yaml ]; then
    runuser -u node -- env HOME=/home/node pnpm install \
      --dir /workspace \
      --store-dir /pnpm/store \
      --frozen-lockfile
    printf '%s\n' "$dependency_hash" > "$marker"
    chown node:node "$marker"
  fi
  exec runuser -u node -- env HOME=/home/node pnpm \
    --dir /workspace dev --host 0.0.0.0 --port 3000
}

if [ "$ACTION" = serve ]; then
  serve
fi

: "${UNFOGY_DEV_REPOSITORY_ID:?Run this contract through 'unfogy dev'.}"
: "${UNFOGY_DEV_PROJECT_NAME:?Run this contract through 'unfogy dev'.}"
: "${UNFOGY_DEV_PORT:?Run this contract through 'unfogy dev'.}"

runtime_environment="$SCRIPT_DIR/.env"
temporary_environment="$runtime_environment.tmp"
umask 077
{
  printf 'UNFOGY_DEV_REPOSITORY_ID=%s\n' "$UNFOGY_DEV_REPOSITORY_ID"
  printf 'UNFOGY_DEV_PROJECT_NAME=%s\n' "$UNFOGY_DEV_PROJECT_NAME"
  printf 'UNFOGY_DEV_PORT=%s\n' "$UNFOGY_DEV_PORT"
} > "$temporary_environment"
mv "$temporary_environment" "$runtime_environment"

compose() {
  docker compose \
    --env-file "$runtime_environment" \
    --project-name "$UNFOGY_DEV_PROJECT_NAME" \
    --file "$SCRIPT_DIR/compose.yaml" \
    "$@"
}

case "$ACTION" in
  up)
    compose up --detach --build --wait --wait-timeout 600 app
    ;;
  down)
    compose down --remove-orphans
    ;;
  logs)
    compose logs --follow --tail 200 app
    ;;
  status)
    compose ps
    docker system df
    ;;
  rebuild)
    compose build --pull app
    compose up --detach --force-recreate --wait --wait-timeout 600 app
    ;;
  purge)
    [ "${UNFOGY_DEV_PURGE_CONFIRMED:-}" = yes ] || {
      echo "purge requires CLI confirmation" >&2
      exit 2
    }
    compose down --volumes --remove-orphans --rmi local
    ;;
  *)
    echo "usage: unfogy dev {up|down|logs|status|rebuild|purge}" >&2
    exit 2
    ;;
esac
